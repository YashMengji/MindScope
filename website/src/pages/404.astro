---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" path="/404">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-5 py-28 text-center">
    <p class="text-7xl font-extrabold text-gradient">404</p>
    <h1 class="mt-4 text-2xl font-bold text-navy">This page wandered off</h1>
    <p class="mt-3 text-navy-soft">
      The page you're looking for doesn't exist — but a mindful moment awaits back
      home.
    </p>
    <a
      href="/"
      class="mt-8 rounded-xl bg-navy-dark px-6 py-3 font-semibold text-white transition-colors hover:bg-navy"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
