---
import { MINDFUL_MESSAGES } from "../consts";
---

<section class="bg-navy py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="inline-block rounded-full bg-indigo-brand/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-sky-light"
      >
        Mindful moments
      </span>
      <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">
        A gentle nudge, not a hard wall
      </h2>
      <p class="mt-4 text-base leading-relaxed text-sky-pale/80">
        Instead of just blocking you, MindScope shows a calm full-screen overlay
        with a rotating reminder of why you set the boundary — then sends you back
        home.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        MINDFUL_MESSAGES.map((m) => (
          <blockquote class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
            <div class="mb-3 text-2xl" aria-hidden="true">
              🛡️
            </div>
            <p class="text-lg font-semibold text-white">{m.headline}</p>
            <p class="mt-2 text-sm leading-relaxed text-sky-pale/75">{m.body}</p>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
