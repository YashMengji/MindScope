---
import {
  SITE_NAME,
  TAGLINE,
  NAV_LINKS,
  GITHUB_URL,
  AUTHOR_EMAIL,
  AUTHOR_NAME,
} from "../consts";
const year = 2026;
---

<footer class="border-t border-slate-200 bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <img src="/icon.png" alt="" class="h-8 w-8 rounded-lg" width="32" height="32" />
          <span class="text-base font-bold text-navy">{SITE_NAME}</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-navy-soft">{TAGLINE}</p>
      </div>

      <div class="flex gap-12">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">
            Pages
          </h3>
          <ul class="mt-3 space-y-2">
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-navy-soft transition-colors hover:text-sky"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">
            Connect
          </h3>
          <ul class="mt-3 space-y-2">
            <li>
              <a
                href={GITHUB_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-navy-soft transition-colors hover:text-sky"
              >
                GitHub
              </a>
            </li>
            <li>
              <a
                href={`mailto:${AUTHOR_EMAIL}`}
                class="text-sm text-navy-soft transition-colors hover:text-sky"
              >
                Contact
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE_NAME}. Built by {AUTHOR_NAME}.</p>
      <p>Android app · Not affiliated with Instagram, YouTube, or WhatsApp.</p>
    </div>
  </div>
</footer>
