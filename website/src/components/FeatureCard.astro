---
interface Props {
  title: string;
  /** Accent hex used for the icon chip + top border */
  accent?: string;
  icon?: string;
}
const { title, accent = "#4a90e2", icon } = Astro.props;
---

<article
  class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg"
>
  <div
    class="absolute inset-x-0 top-0 h-1 opacity-80"
    style={`background:${accent}`}
  >
  </div>
  <div
    class="flex h-11 w-11 items-center justify-center rounded-xl text-xl"
    style={`background:${accent}1a;color:${accent}`}
  >
    {icon ?? "•"}
  </div>
  <h3 class="mt-4 text-lg font-bold text-navy">{title}</h3>
  <div class="mt-2 text-sm leading-relaxed text-navy-soft">
    <slot />
  </div>
</article>
